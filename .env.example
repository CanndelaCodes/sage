# Sage Environment Configuration
# Copy this file to .env and fill in your values
# NEVER commit the .env file to version control

# ============================================================
# LLM Provider API Keys (BYOK - Bring Your Own Key)
# ============================================================

# Claude (Anthropic) - Recommended default
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# OpenAI (optional, for multi-provider routing)
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ============================================================
# Gateway Configuration
# ============================================================

# Gateway auth token (auto-generated on first run if not set)
SAGE_GATEWAY_TOKEN=

# Gateway auth password (optional, alternative to token)
SAGE_GATEWAY_PASSWORD=

# Gateway port (default: 18789)
# SAGE_GATEWAY_PORT=18789

# ============================================================
# State & Config Paths (optional overrides)
# ============================================================

# State directory for sessions, logs, caches (default: ~/.sage)
# SAGE_STATE_DIR=

# Config file path (default: $SAGE_STATE_DIR/sage.json)
# SAGE_CONFIG_PATH=

# Agent working directory
# SAGE_AGENT_DIR=

# Config profile name
# SAGE_PROFILE=

# ============================================================
# Messaging Platform Credentials
# ============================================================

# Twilio (WhatsApp)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
# Must be a WhatsApp-enabled Twilio number, prefixed with whatsapp:
TWILIO_WHATSAPP_FROM=whatsapp:+1XXXXXXXXXX

# Discord bot token (raw token only, no prefix)
# DISCORD_BOT_TOKEN=

# Telegram bot token
# TELEGRAM_BOT_TOKEN=

# Slack tokens (managed via OAuth flow)
# SLACK_BOT_TOKEN=
# SLACK_APP_TOKEN=

# ============================================================
# Docker/Container Sandbox (optional)
# ============================================================

# Extra apt packages to install in Docker sandbox
# SAGE_DOCKER_APT_PACKAGES=

# Extra Docker volume mounts
# SAGE_EXTRA_MOUNTS=

# Docker home volume name
# SAGE_HOME_VOLUME=

# ============================================================
# Advanced / Debug
# ============================================================

# Skip canvas host startup
# SAGE_SKIP_CANVAS_HOST=1

# Disable process respawn
# SAGE_NO_RESPAWN=1

# Session cache TTL in milliseconds
# SAGE_SESSION_CACHE_TTL_MS=

# Enable Anthropic payload logging (debug)
# SAGE_ANTHROPIC_PAYLOAD_LOG=1

# Nix mode (set by Nix, do not set manually)
# SAGE_NIX_MODE=1
