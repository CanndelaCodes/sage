{
  "name": "@sage/windows-overlay",
  "private": true,
  "type": "module",
  "main": "dist/main/main.js",
  "scripts": {
    "build": "tsdown --config tsdown.config.ts && node scripts/copy-renderer-assets.mjs",
    "dev": "pnpm build && electron .",
    "smoke": "powershell -ExecutionPolicy Bypass -File ../../scripts/sageos-windows-overlay.ps1",
    "test": "vitest run --config vitest.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "lit": "^3.3.2"
  },
  "devDependencies": {
    "electron": "^38.0.0",
    "tsdown": "^0.20.1",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  }
}
